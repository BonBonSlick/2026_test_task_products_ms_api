{
    "openapi": "3.0.0",
    "info": {
        "title": "Products API",
        "description": "API to manage products",
        "version": "1.0.0"
    },
    "paths": {
        "/product/create": {
            "post": {
                "tags": [
                    "Product"
                ],
                "summary": "Create a new product",
                "operationId": "post_product.create",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/product/list": {
            "get": {
                "tags": [
                    "Product"
                ],
                "summary": "Get list of products",
                "operationId": "get_product.list",
                "responses": {
                    "200": {
                        "description": "List of products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Product2"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/product/{id}": {
            "get": {
                "tags": [
                    "Product"
                ],
                "summary": "Get product by ID",
                "operationId": "get_product.info",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateProductDTO": {
                "required": [
                    "name",
                    "sku",
                    "price",
                    "quantity"
                ],
                "properties": {
                    "name": {
                        "description": "The unique identifier of the product.",
                        "type": "string",
                        "maxLength": 50,
                        "minLength": 2
                    },
                    "sku": {
                        "description": "The unique SKU of the product.",
                        "type": "string",
                        "maxLength": 12,
                        "minLength": 2
                    },
                    "price": {
                        "description": "Price of the product.",
                        "type": "string",
                        "minimum": 0
                    },
                    "quantity": {
                        "description": "Total products in stock.",
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "type": "object"
            },
            "Product": {
                "required": [
                    "id",
                    "name",
                    "price",
                    "sku",
                    "quantity"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "price": {
                        "type": "string"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "Product2": {
                "required": [
                    "id",
                    "name",
                    "price"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "price": {
                        "type": "string"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Product",
            "description": "Product management"
        }
    ]
}
